# ====================================================================
# GREENLOOPAI — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy to .env and configure actual secrets in your local environment.
# NEVER commit .env with real credentials into source control.
# ====================================================================

# 1. Frontend
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:5500

# 2. Java Spring Boot Security Gateway
SPRING_PORT=8080
FASTAPI_BASE_URL=http://localhost:8000

# 3. OAuth2 / JWT Validation (External Identity Provider)
JWT_ISSUER_URI=http://localhost:8080/auth/realms/greenloopai
JWT_AUDIENCE=greenloopai-client

# 4. Internal Service Authentication
FASTAPI_SERVICE_TOKEN=dev-internal-secret-token

# 5. OpenAI API Configuration (Server-Side Only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 6. Computer Vision / YOLO Model Path
YOLO_MODEL_PATH=ai-service/models/yolov8n-waste.pt

# 7. Upload & Security Limits
MAX_UPLOAD_SIZE=10MB
