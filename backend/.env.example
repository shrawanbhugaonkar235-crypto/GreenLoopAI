# GreenLoopAI — Environment Configuration Example
# Copy this file to .env and configure your values

# MongoDB Atlas Database Connection
# Replace with your MongoDB Atlas connection string:
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Use 'mock' or 'mongomock' for offline unit testing without a live cluster
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=greenloopai

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-in-production
JWT_EXPIRE_MINUTES=1440

# AI Model & Pipeline Settings
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONF=0.25
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# CORS Configuration (allowed frontend origins separated by comma)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5000,http://127.0.0.1:8000

# Upload Limits & Reward Settings
MAX_UPLOAD_MB=10
GREENCOINS_PER_SCORE=0.5
